<!DOCTYPE html>
<html>
<head>
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Task Manager</title>
    <base href="/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/dist/browser/styles.css" />
</head>
<body>
    <div class="container">
        @RenderBody()
    </div>

    <!-- Angular -->
    <script src="/dist/browser/runtime.js"></script>
    <script src="/dist/browser/polyfills.js"></script>
    <script src="/dist/browser/main.js"></script>

    <!-- jQuery (CDN or local) -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <!-- Optional Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        window.refreshTasks = function () {
            $.ajax({
                url: 'https://localhost:7216/api/tasks/getTasks?pageNumber=1&pageSize=5',
                method: 'GET',
                success: function (response) {
                    alert('Tasks refreshed! (From outside Angular)');
                },
                error: function (err) {
                    console.error('Error refreshing tasks:', err);
                    alert('Failed to refresh tasks.');
                }
            });
        };
    </script>


</body>
</html>

